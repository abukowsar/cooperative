# Copy to .env.local and fill in. Never commit .env.local.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=dairy_coop
# Long random string used to sign login cookies, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me
# Key typed into "মডারেটর প্রবেশ" to moderate the forum, experts and trainings
MODERATOR_KEY=change-me
